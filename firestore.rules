            && after.archived is bool && after.archivedAt == request.time && after.archivedBy == request.auth.uid
            && (before.get('createdBy','') == request.auth.uid || (!('createdBy' in before) && before.author == (legacyAlias() == 'Alejandro' ? 'Ale' : 'Val')))));
    }
    match /movies/{id} {
      allow read: if isVip();
      allow create: if isVip() && movieCreate(request.resource.data,id);
      allow update: if isVip() && movieUpdate(resource.data,request.resource.data,id);
      allow delete: if false;
    }
    function reservationCreate(data,id) {
      return uuid(id) && data.keys().hasAll(['id','movieId','movieTitle','dateName','showDate','showtime','reservedAt','schemaVersion','createdBy','savedAt','status'])
        && data.keys().hasOnly(['id','movieId','movieTitle','dateName','showDate','showtime','reservedAt','schemaVersion','createdBy','savedAt','status','poster'])
        && data.id == id && data.schemaVersion == 2 && data.createdBy == request.auth.uid && data.savedAt == request.time && data.status == 'active'
