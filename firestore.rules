        && (!changed.hasAny(['coverMediaId','coverMediaIndex']) || isValidCover(after, memoryId));
    }
    // Shared studio records: history date is presentation; savedAt is authority.
    function isValidStudioBase(data, recordId) {
      return recordId.matches('[0-9a-f]{8}-[0-9a-f]{4}-[45][0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}')
        && data.keys().hasAll(['id','createdAt','createdBy','schemaVersion','savedAt'])
        && data.id == recordId && data.schemaVersion == 1
        && data.createdBy in ["bIlEa1IXdbO73ahuiESYy8Zbfgv1","DV7KauCOERWGAmEl38C5z0iPLuJ3","ToJa2Pea8scsqUVww1HHB1HIArE2"] && data.savedAt is timestamp
        && data.createdAt is string && data.createdAt.size() <= 32
        && data.createdAt.matches('[1-9][0-9]{3}-[0-9]{2}-[0-9]{2}T([01][0-9]|2[0-3]):[0-5][0-9]:[0-5][0-9][.][0-9]{3}Z')
        && isCalendarDate(data.createdAt[0:10]);
    }
    function isValidLetter(data, recordId) {
      return isValidStudioBase(data, recordId)
        && data.keys().hasAll(['title','body','author','tag','occasion'])
        && data.keys().hasOnly(['id','createdAt','createdBy','schemaVersion','savedAt','title','body','author','tag','occasion'])
        && data.title is string && data.title.trim().size() > 0 && data.title.size() <= 100
        && data.body is string && data.body.trim().size() > 0 && data.body.size() <= 12000
        && data.author in ['Ale','Val'] && data.tag in ['Para hoy','Abre cuando']
        && data.occasion is string && data.occasion.size() <= 120
        && ((data.tag == 'Para hoy' && data.occasion == '') || (data.tag == 'Abre cuando' && data.occasion.trim().size() > 0));
    }
    function isValidSong(data, recordId) {
      return isValidStudioBase(data, recordId)
        && data.keys().hasAll(['title','artist','note','author','url','kind'])
        && data.keys().hasOnly(['id','createdAt','createdBy','schemaVersion','savedAt','title','artist','note','author','url','kind'])
        && data.title is string && data.title.trim().size() > 0 && data.title.size() <= 140
        && data.artist is string && data.artist.trim().size() > 0 && data.artist.size() <= 120
        && data.note is string && data.note.trim().size() > 0 && data.note.size() <= 2000
        && data.author in ['Ale','Val'] && data.kind in ['track','playlist','album']
        && data.url is string && data.url.size() <= 250
        && data.url.matches('https://open[.]spotify[.]com/' + data.kind + '/[A-Za-z0-9]{1,100}');
    }
    function isValidPlan(data, recordId) {
      return isValidStudioBase(data, recordId)
        && data.keys().hasAll(['title','note','category','date','done','author'])
        && data.keys().hasOnly(['id','createdAt','createdBy','schemaVersion','savedAt','title','note','category','date','done','author','updatedAt'])
        && data.title is string && data.title.trim().size() > 0 && data.title.size() <= 140
        && data.note is string && data.note.size() <= 2000
        && data.category in ['Una cita','Una aventura','En casita','Por descubrir']
        && isDateOrEmpty(data.date) && (data.date == '' || (data.date >= '1900-01-01' && data.date <= '2200-12-31'))
        && data.author in ['Ale','Val'] && data.done is bool && (!('updatedAt' in data) || data.updatedAt is timestamp);
    }
    match /memories/{memoryId} {
      allow read: if isVip();
      allow create: if resource == null && isVip() && isValidNewMetadata(request.resource.data) && isValidCreate(request.resource.data, memoryId);
      allow update: if resource != null && isVip() && isValidMemory(request.resource.data) && isValidUpdate(resource.data, request.resource.data, memoryId);
      allow delete: if false;
    }
    match /letters/{recordId} {
      allow read: if isVip();
      allow create: if resource == null && isVip() && isValidLetter(request.resource.data, recordId)
        && request.resource.data.createdBy == request.auth.uid && request.resource.data.savedAt == request.time;
      allow update, delete: if false;
    }
    match /songs/{recordId} {
      allow read: if isVip();
      allow create: if resource == null && isVip() && isValidSong(request.resource.data, recordId)
        && request.resource.data.createdBy == request.auth.uid && request.resource.data.savedAt == request.time;
      allow update, delete: if false;
    }
    match /plans/{recordId} {
      allow read: if isVip();
      allow create: if resource == null && isVip() && isValidPlan(request.resource.data, recordId)
        && !('updatedAt' in request.resource.data)
        && request.resource.data.createdBy == request.auth.uid && request.resource.data.savedAt == request.time;
      allow update: if resource != null && isVip() && isValidPlan(request.resource.data, recordId)
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['done','updatedAt'])
        && request.resource.data.diff(resource.data).removedKeys().size() == 0
        && request.resource.data.updatedAt == request.time;
      allow delete: if false;
    }
    match /movies/{recordId} {
      allow read, write: if isVip();
    }
    match /reservations/{recordId} {
      allow read, write: if isVip();
    }
    match /{document=**} { allow read, write: if false; }
  }
}
