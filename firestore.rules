    function indexedLegacyCover(items, cover, memoryId, index) {
      return index is int && index >= 0 && index < items.size()
        && items[index] is map
        && items[index].get('id', memoryId + '-media-' + string(index + 1)) == cover;
    }
    function isValidCover(data, memoryId) {
      let items = data.get('media', []); let cover = data.get('coverMediaId', '');
      return !('coverMediaId' in data) ? !('coverMediaIndex' in data) : (cover is string && cover.size() <= 180
        && items is list
        && (data.get('schemaVersion', 0) == 2
          ? (!('coverMediaIndex' in data) && isConstructedCover(cover, memoryId, items.size()))
          : ((items.size() == 0 && cover == '' && !('coverMediaIndex' in data))
            || (cover != '' && ('coverMediaIndex' in data
              ? indexedLegacyCover(items, cover, memoryId, data.coverMediaIndex)
              : (legacyCover(items, cover, memoryId) || explicitCover(items, cover)))))));
    }
    function isValidCreate(data, memoryId) {
      return memoryId.matches('[A-Za-z0-9]{20}')
        && data.keys().hasAll(['title','description','photoDate','location','tags','album','author','createdBy','createdAt','media','favorites','coverMediaId','schemaVersion'])
        && data.keys().hasOnly(['title','description','photoDate','location','tags','album','author','createdBy','createdAt','media','favorites','coverMediaId','reminder','schemaVersion'])
        && data.createdBy == request.auth.uid && data.createdAt == request.time
        && data.favorites is list && data.favorites.size() == 0
        && data.schemaVersion == 2
        && isValidNewMedia(data.media, data.coverMediaId, memoryId);
    }
    // Create requires every metadata field. Direct checks preserve the generic
    // validator's constraints without repeating optional-field or timestamp work.
    function isValidNewMetadata(data) {
      return data.title.matches('(?s).{1,160}') && data.title.trim().size() > 0
        && data.description is string && data.description.size() <= 12000
        && isDateOrEmpty(data.photoDate)
        && data.location.matches('(?s).{0,200}')
        && data.album.matches('(?s).{0,100}')
        && data.author.matches('(?s).{0,100}')
        && isValidTags(data.tags)
        && (!('reminder' in data) || isValidReminder(data.reminder));
    }
    function ownFavoriteChanges(before, after) {
      let own = [request.auth.uid, legacyAlias()];
      return after.toSet().difference(before.toSet()).hasOnly(own)
        && before.toSet().difference(after.toSet()).hasOnly(own);
    }
    function isValidUpdate(before, after, memoryId) {
      let difference = after.diff(before); let changed = difference.affectedKeys();
      return difference.removedKeys().size() == 0
        && after.get('updatedAt', null) == request.time
        && (changed.hasOnly(['title','description','photoDate','location','tags','album','coverMediaId','coverMediaIndex','reminder','updatedAt'])
          || (changed.hasOnly(['favorites','updatedAt'])
            && isValidFavorites(after.get('favorites', []))
            && ownFavoriteChanges(before.get('favorites', []), after.get('favorites', []))))
        && (!changed.hasAny(['coverMediaId','coverMediaIndex']) || isValidCover(after, memoryId));
    }
    // Shared studio: optional presentation fields are compatible with old records.
    // All edits atomically retain the exact preceding document in revisions/.
    function uuid(value) { return value is string && value.matches('[0-9a-f]{8}-[0-9a-f]{4}-[45][0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}'); }
    function bounded(value, limit, required) { return value is string && value.size() <= limit && (!required || value.trim().size() > 0); }
    function isoDate(value) {
      return value is string && value.size() == 24
        && value.matches('[1-9][0-9]{3}-[0-9]{2}-[0-9]{2}T([01][0-9]|2[0-3]):[0-5][0-9]:[0-5][0-9][.][0-9]{3}Z')
        && isCalendarDate(value[0:10]);
    }
    function httpsUrl(value, limit) { return bounded(value, limit, true) && value.matches('https://[A-Za-z0-9.-]+([/?#].*)?'); }
    function spotifyUrl(value) { return bounded(value, 500, true) && value.matches('https://open[.]spotify[.]com/(track|playlist|album)/[A-Za-z0-9]{1,100}'); }
    function optionalUrl(data, key, limit) { return !(key in data) || httpsUrl(data[key], limit); }
    function optionalText(data, key, limit) { return !(key in data) || bounded(data[key], limit, false); }
    function startSeconds(data) { return !('startSeconds' in data) || (data.startSeconds is number && data.startSeconds >= 0 && data.startSeconds <= 86400); }
    function letterSong(data) {
      return data is map && data.keys().hasAll(['title','artist'])
        && data.keys().hasOnly(['id','title','artist','artworkUrl','previewUrl','spotifyUrl','catalogUrl','startSeconds'])
        && bounded(data.title,140,true) && bounded(data.artist,120,true)
        && (!('id' in data) || bounded(data.id,128,true))
        && optionalUrl(data,'artworkUrl',1200) && optionalUrl(data,'previewUrl',1200) && optionalUrl(data,'catalogUrl',1200)
        && (!('spotifyUrl' in data) || spotifyUrl(data.spotifyUrl)) && startSeconds(data);
    }
    function studioBase(data, id) {
      return uuid(id) && data.keys().hasAll(['id','createdAt','createdBy','schemaVersion','savedAt','author'])
        && data.id == id && data.schemaVersion == 1 && isoDate(data.createdAt)
        && data.createdBy in ['bIlEa1IXdbO73ahuiESYy8Zbfgv1','DV7KauCOERWGAmEl38C5z0iPLuJ3','ToJa2Pea8scsqUVww1HHB1HIArE2']
        && data.savedAt is timestamp && data.author in ['Ale','Val']
        && (!('archived' in data) || data.archived is bool)
        && (!('updatedAt' in data) || data.updatedAt is timestamp)
        && (!('revisionId' in data) || uuid(data.revisionId));
    }
    function studioLetter(data, id) {
      return studioBase(data,id) && data.keys().hasAll(['title','body','tag','occasion'])
        && bounded(data.title,100,true) && bounded(data.body,12000,true)
        && data.tag in ['Para hoy','Abre cuando'] && bounded(data.occasion,120,data.tag == 'Abre cuando')
        && (data.tag != 'Para hoy' || data.occasion == '')
        && (!('color' in data) || data.color in ['rose','lavender','peach','mint','sky','gold'])
        && (!('unlockAt' in data) || isoDate(data.unlockAt)) && (!('song' in data) || letterSong(data.song));
    }
    function studioSong(data, id) {
      return studioBase(data,id) && data.keys().hasAll(['title','artist','note','url','kind'])
        && bounded(data.title,140,true) && bounded(data.artist,120,true) && bounded(data.note,2000,true)
        && data.kind in ['track','playlist','album']
