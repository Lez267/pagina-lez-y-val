    }
    match /gameRecords/{id} {
      allow read: if isVip();
      allow create: if isVip() && gameRecord(request.resource.data,id);
      allow update: if isVip() && gameRecord(request.resource.data,id)
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['stars','score','completedAt','metricLabel','savedAt'])
        && request.resource.data.stars >= resource.data.stars && request.resource.data.score >= resource.data.score;
      allow delete: if false;
    }
    match /{document=**} { allow read, write: if false; }
  }
}
