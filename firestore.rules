      allow create: if resource == null && isVip() && isValidNewMetadata(request.resource.data) && isValidCreate(request.resource.data, memoryId);
      allow update: if resource != null && isVip() && isValidMemory(request.resource.data) && isValidUpdate(resource.data, request.resource.data, memoryId);
      allow delete: if false;
    }
    match /{kind}/{recordId} {
