        allow create: if kind in ['letters','songs','plans','movies','reservations'] && isVip() && uuid(revisionId)
          && request.resource.data.keys().hasAll(['before','editedBy','savedAt'])
          && request.resource.data.keys().hasOnly(['before','editedBy','savedAt'])
          && request.resource.data.editedBy == request.auth.uid && request.resource.data.savedAt == request.time
          && request.resource.data.before == get(/databases/$(database)/documents/$(kind)/$(recordId)).data
          && getAfter(/databases/$(database)/documents/$(kind)/$(recordId)).data.revisionId == revisionId;
        allow update, delete: if false;
      }
    }
    // Cinema preserves legacy fields; updates can only mark watched or archive.
    function movieData(data,id) {
      return data.keys().hasAll(['id','title','note','author','watched','createdAt']) && data.id == id
        && id.matches('[A-Za-z0-9_-]{1,128}') && bounded(data.title,200,true) && bounded(data.note,10000,false)
        && data.author in ['Ale','Val'] && data.watched is bool && isoDate(data.createdAt)
        && (!('year' in data) || bounded(data.year,10,false) || (data.year is int && data.year >= 1880 && data.year <= 2300))
        && optionalUrl(data,'poster',2048) && optionalText(data,'stars',1000)
        && (!('watchedDate' in data) || isCalendarDate(data.watchedDate))
        && optionalText(data,'duration',80) && optionalText(data,'classification',40) && optionalText(data,'format',80)
        && (!('archived' in data) || data.archived is bool);
    }
    function movieCreate(data,id) {
      return movieData(data,id) && data.schemaVersion == 2 && data.createdBy == request.auth.uid && data.savedAt == request.time
        && data.keys().hasAll(['schemaVersion','createdBy','savedAt'])
        && data.keys().hasOnly(['id','title','note','author','watched','createdAt','schemaVersion','createdBy','savedAt','year','poster','stars','watchedDate','duration','classification','format']);
    }
    function movieUpdate(before,after,id) {
      let changed = after.diff(before);
      return movieData(after,id) && changed.removedKeys().size() == 0 && recordedRevision('movies',id,before,after)
        && ((changed.affectedKeys().hasOnly(['watched','watchedDate','updatedAt','revisionId']) && after.updatedAt == request.time)
