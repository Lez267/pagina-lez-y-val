        || (n > 119 ? (items[112].get('id', '') == cover || items[113].get('id', '') == cover || items[114].get('id', '') == cover || items[115].get('id', '') == cover || items[116].get('id', '') == cover || items[117].get('id', '') == cover || items[118].get('id', '') == cover || items[119].get('id', '') == cover) : ((n > 112 && items[112].get('id', '') == cover) || (n > 113 && items[113].get('id', '') == cover) || (n > 114 && items[114].get('id', '') == cover) || (n > 115 && items[115].get('id', '') == cover) || (n > 116 && items[116].get('id', '') == cover) || (n > 117 && items[117].get('id', '') == cover) || (n > 118 && items[118].get('id', '') == cover) || (n > 119 && items[119].get('id', '') == cover)))
        || (n > 127 ? (items[120].get('id', '') == cover || items[121].get('id', '') == cover || items[122].get('id', '') == cover || items[123].get('id', '') == cover || items[124].get('id', '') == cover || items[125].get('id', '') == cover || items[126].get('id', '') == cover || items[127].get('id', '') == cover) : ((n > 120 && items[120].get('id', '') == cover) || (n > 121 && items[121].get('id', '') == cover) || (n > 122 && items[122].get('id', '') == cover) || (n > 123 && items[123].get('id', '') == cover) || (n > 124 && items[124].get('id', '') == cover) || (n > 125 && items[125].get('id', '') == cover) || (n > 126 && items[126].get('id', '') == cover) || (n > 127 && items[127].get('id', '') == cover))));
