    function legacyOrdinalCover(items, suffix) {
      let ordinal = int(suffix);
      return ordinal >= 1 && ordinal <= items.size() && !('id' in items[ordinal - 1]);
    }
    function legacyCover(items, cover, memoryId) {
      let prefix = memoryId + '-media-';
      return cover.size() > prefix.size() && cover[0:prefix.size()] == prefix
        && cover[prefix.size():].matches('[1-9][0-9]{0,2}')
        && legacyOrdinalCover(items, cover[prefix.size():]);
    }
    function indexedLegacyCover(items, cover, memoryId, index) {
      return index is int && index >= 0 && index < items.size()
        && items[index] is map
        && items[index].get('id', memoryId + '-media-' + string(index + 1)) == cover;
    }
    function isValidCover(data, memoryId) {
      let items = data.get('media', []); let cover = data.get('coverMediaId', '');
      return !('coverMediaId' in data) ? !('coverMediaIndex' in data) : (cover is string && cover.size() <= 180
        && items is list
        && (data.get('schemaVersion', 0) == 2
          ? (!('coverMediaIndex' in data) && isConstructedCover(cover, memoryId, items.size()))
          : ((items.size() == 0 && cover == '' && !('coverMediaIndex' in data))
            || (cover != '' && ('coverMediaIndex' in data
              ? indexedLegacyCover(items, cover, memoryId, data.coverMediaIndex)
              : (legacyCover(items, cover, memoryId) || explicitCover(items, cover)))))));
    }
    function isValidCreate(data, memoryId) {
      return memoryId.matches('[A-Za-z0-9]{20}')
        && data.keys().hasAll(['title','description','photoDate','location','tags','album','author','createdBy','createdAt','media','favorites','coverMediaId','schemaVersion'])
        && data.keys().hasOnly(['title','description','photoDate','location','tags','album','author','createdBy','createdAt','media','favorites','coverMediaId','reminder','schemaVersion'])
        && data.createdBy == request.auth.uid && data.createdAt == request.time
        && data.favorites is list && data.favorites.size() == 0
        && data.schemaVersion == 2
        && isValidNewMedia(data.media, data.coverMediaId, memoryId);
    }
    // Create requires every metadata field. Direct checks preserve the generic
    // validator's constraints without repeating optional-field or timestamp work.
    function isValidNewMetadata(data) {
      return data.title.matches('(?s).{1,160}') && data.title.trim().size() > 0
        && data.description is string && data.description.size() <= 12000
        && isDateOrEmpty(data.photoDate)
        && data.location.matches('(?s).{0,200}')
        && data.album.matches('(?s).{0,100}')
        && data.author.matches('(?s).{0,100}')
        && isValidTags(data.tags)
        && (!('reminder' in data) || isValidReminder(data.reminder));
    }
    function ownFavoriteChanges(before, after) {
      let own = [request.auth.uid, legacyAlias()];
      return after.toSet().difference(before.toSet()).hasOnly(own)
        && before.toSet().difference(after.toSet()).hasOnly(own);
    }
    function isValidUpdate(before, after, memoryId) {
      let difference = after.diff(before); let changed = difference.affectedKeys();
      return difference.removedKeys().size() == 0
        && after.get('updatedAt', null) == request.time
        && (changed.hasOnly(['title','description','photoDate','location','tags','album','coverMediaId','coverMediaIndex','reminder','updatedAt'])
          || (changed.hasOnly(['favorites','updatedAt'])
            && isValidFavorites(after.get('favorites', []))
