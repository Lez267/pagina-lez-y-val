rules_version = '2';
// PROTOTYPE for lezz-val-universo/(default). Review and test before deployment.
// memories/{id}: shared private memories, readable/editable only by fixed VIP identities.
// Mutable: title<=160, description<=12000, photoDate calendar string or '',
// location<=200, tags<=12 strings<=40, album<=100, coverMediaId<=180,
// legacy coverMediaIndex is a bounds-checked raw-array reference, never media data.
// reminder exact bounded map, updatedAt=request.time. Favorites: only own UID/alias.
// Immutable on update: media, url, type, storagePath, author, createdBy, createdAt,
// schemaVersion and EVERY unknown/original field. No field deletion is allowed.
// New records: schemaVersion=2, media=1..20 unique canonical Cloudinary URLs.
// Type/path are encoded in each URL; IDs are memoryId+'-media-'+ordinal.
// Legacy media maps/URLs are immutable and remain in their existing form.
// New records use the signed namespace, createdBy=caller,
// createdAt=request.time, empty favorites. Every delete and all other paths denied.
service cloud.firestore {
  match /databases/{database}/documents {
    function isVip() {
      return request.auth != null && database == '(default)'
        && request.auth.uid in ["bIlEa1IXdbO73ahuiESYy8Zbfgv1","DV7KauCOERWGAmEl38C5z0iPLuJ3","ToJa2Pea8scsqUVww1HHB1HIArE2"]
        && request.auth.token.get('email_verified', false) == true
        && request.auth.token.get('firebase', {}).get('sign_in_provider', '') == 'google.com';
    }
    function legacyAlias() { return request.auth.uid in ["DV7KauCOERWGAmEl38C5z0iPLuJ3","ToJa2Pea8scsqUVww1HHB1HIArE2"] ? 'Valeria' : 'Alejandro'; }
    function isCalendarDate(value) {
      return value is string && value.matches('[1-9][0-9]{3}-(0[1-9]|1[0-2])-(0[1-9]|[12][0-9]|3[01])')
        && actualCalendarDate(value);
    }
    function actualCalendarDate(value) {
      let y = int(value[0:4]); let m = int(value[5:7]); let d = int(value[8:10]);
      let instant = timestamp.date(y, m, d);
      return instant.year() == y && instant.month() == m && instant.day() == d;
    }
    function isDateOrEmpty(value) { return value is string && (value == '' || isCalendarDate(value)); }
    function isValidTags(tags) {
      let n = tags.size();
      return tags is list && n <= 12 && tags.toSet().size() == n
        && (n <= 0 || tags[0].matches('[^\\r\\n]{1,40}'))
        && (n <= 1 || tags[1].matches('[^\\r\\n]{1,40}'))
        && (n <= 2 || tags[2].matches('[^\\r\\n]{1,40}'))
        && (n <= 3 || tags[3].matches('[^\\r\\n]{1,40}'))
        && (n <= 4 || tags[4].matches('[^\\r\\n]{1,40}'))
        && (n <= 5 || tags[5].matches('[^\\r\\n]{1,40}'))
        && (n <= 6 || tags[6].matches('[^\\r\\n]{1,40}'))
        && (n <= 7 || tags[7].matches('[^\\r\\n]{1,40}'))
        && (n <= 8 || tags[8].matches('[^\\r\\n]{1,40}'))
        && (n <= 9 || tags[9].matches('[^\\r\\n]{1,40}'))
        && (n <= 10 || tags[10].matches('[^\\r\\n]{1,40}'))
        && (n <= 11 || tags[11].matches('[^\\r\\n]{1,40}'));
    }
    function isValidReminder(value) {
      return value is map && value.keys().hasAll(['enabled', 'date', 'label', 'repeat'])
        && value.keys().hasOnly(['enabled', 'date', 'label', 'repeat'])
        && value.enabled is bool && isDateOrEmpty(value.date)
        && value.label is string && value.label.size() <= 120
        && value.repeat in ['once', 'yearly']
        && (!value.enabled || (value.date != '' && value.label.trim().size() > 0));
    }
    function isValidFavorites(value) {
      return value is list && value.size() <= 5
        && value.toSet().size() == value.size()
        && value.hasOnly(["bIlEa1IXdbO73ahuiESYy8Zbfgv1","DV7KauCOERWGAmEl38C5z0iPLuJ3","ToJa2Pea8scsqUVww1HHB1HIArE2","Alejandro","Valeria"]);
    }
    function isValidMemory(data) {
      return (!('title' in data) || (data.title.matches('(?s).{1,160}') && data.title.trim().size() > 0))
        && (!('description' in data) || (data.description is string && data.description.size() <= 12000))
        && (!('photoDate' in data) || isDateOrEmpty(data.photoDate))
        && (!('location' in data) || data.location.matches('(?s).{0,200}'))
        && (!('album' in data) || data.album.matches('(?s).{0,100}'))
        && (!('author' in data) || data.author.matches('(?s).{0,100}'))
        && (!('tags' in data) || isValidTags(data.tags))
        && (!('favorites' in data) || isValidFavorites(data.favorites))
        && (!('reminder' in data) || isValidReminder(data.reminder))
        && (!('createdAt' in data) || data.createdAt is timestamp)
        && (!('updatedAt' in data) || data.updatedAt is timestamp);
    }
    function isValidNewMedia(items, cover, memoryId) {
      let n = items.size();
      return items is list && n >= 1 && n <= 20
        && items.toSet().size() == n
        && (n <= 0 || items[0].matches('https://res[.]cloudinary[.]com/dc7x4qjzu/(image|video)/upload/v[0-9]{1,20}/nuestro-universo/[0-9a-f]{24}/[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}([.][A-Za-z0-9]{1,8})?'))
