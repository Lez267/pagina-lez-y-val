    }
    function gameRecord(data,id) {
      return data.keys().hasAll(['schemaVersion','uid','player','game','level','stars','score','completedAt','metricLabel','savedAt'])
        && data.keys().hasOnly(['schemaVersion','uid','player','game','level','stars','score','completedAt','metricLabel','savedAt'])
        && data.schemaVersion == 1 && data.uid == request.auth.uid
        && data.player == (legacyAlias() == 'Alejandro' ? 'ale' : 'valeria')
        && data.game in ['puzzle','memory','diamond'] && data.level is int && data.level >= 1 && data.level <= 5
        && id == data.uid + '_' + data.game + '_' + string(data.level)
        && data.stars is int && data.stars >= 1 && data.stars <= 3
        && data.score is int && data.score >= 0 && data.score <= 10000
